{
  "name": "dfbrowse",
  "version": "1.0.0",
  "description": "DFBrowse — a password-managed allowlist browser for focused studying.",
  "main": "src/main.js",
  "author": "pranessadhwin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node server/dist/index.js",
    "start:web": "node server/dist/index.js",
    "start:electron": "electron .",
    "dev": "npm run dev:server & npm run dev:client",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:web",
    "build:web": "cd client && npm run build && cd ../server && npm run build",
    "build:dir": "electron-builder --dir",
    "build:win": "electron-builder --win nsis",
    "build:electron": "electron-builder --win nsis",
    "test:policy": "node test/policy.test.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "resedit": "^2.0.2"
  },
  "build": {
    "appId": "com.dfbrowse.app",
    "productName": "DFBrowse",
    "copyright": "Copyright © 2026 pranessadhwin",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DFBrowseSetup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DFBrowse",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "differentialPackage": false,
      "include": "build/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    }
  }
}
